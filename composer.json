{
    "name": "g4t/laravel-bee-queue",
    "description": "A simple, fast, Redis-backed job queue for Laravel — inspired by bee-queue",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "queue", "redis", "jobs"],
    "authors": [
        {
            "name": "G4T",
            "email": "hussein4alaa@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/redis": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "G4T\\BeeQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "G4T\\BeeQueue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "G4T\\BeeQueue\\BeeQueueServiceProvider"
            ],
            "aliases": {
                "BeeQueue": "G4T\\BeeQueue\\Facades\\BeeQueue"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
